---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContributionAnnouncement from '../../components/ContributionAnnouncement';
import GitHubStarButton from '../../components/GitHubStarButton';
import ParticipationChart from '../../components/ParticipationChart.astro';
import organizationsData from '../../data/organizations.json';
import { buildTaxonomyHubs, hubSlug } from '../../lib/hubs';
import type { Organization } from '../../types';

const organizations = organizationsData as Organization[];
const technologyHubSlugs = new Set(
  buildTaxonomyHubs(organizations, 'technology').map((hub) => hub.slug),
);
const topicHubSlugs = new Set(
  buildTaxonomyHubs(organizations, 'topic').map((hub) => hub.slug),
);

export function getStaticPaths() {
  return (organizationsData as Organization[]).map((organization) => ({
    params: { slug: organization.slug },
    props: { organization },
  }));
}

interface Props {
  organization: Organization;
}

const { organization } = Astro.props;
const primaryRepository = organization.repository.repositories[0];
const repositoryFallback = organization.repository.organizationProfile;
const initials = organization.name
  .split(/\s+/)
  .slice(0, 2)
  .map((word) => word[0])
  .join('');
const canonicalUrl = new URL(`/org/${organization.slug}/`, Astro.site);
const organizationEntityId = `${canonicalUrl.href}#organization`;
const repositoryUrls = organization.repository.repositories.map(
  (repository) => repository.url,
);
const sameAs = [organization.website, ...repositoryUrls].filter(Boolean);
const organizationStructuredData = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'GSoC Organizations',
        item: new URL('/', Astro.site).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: organization.name,
        item: canonicalUrl.href,
      },
    ],
  },
  {
    '@type': 'Organization',
    '@id': organizationEntityId,
    name: organization.name,
    description: organization.description,
    ...(organization.logo
      ? { logo: new URL(organization.logo, Astro.site).href }
      : {}),
    ...(sameAs.length ? { sameAs } : {}),
    knowsAbout: [...organization.technologies, ...organization.topics],
  },
];
---

<BaseLayout
  title={organization.name}
  description={`${organization.description} Explore ${organization.totalProjects} historical GSoC projects across ${organization.participationCount} program years.`}
  pageAboutId={organizationEntityId}
  structuredData={organizationStructuredData}
>
  <main class="detail-page">
    <header class="directory-header profile-directory-header">
      <div class="directory-brand">
        <a
          class="directory-brand-link"
          href="/"
          aria-label="GSoC Organizations home"
        >
          <img
            class="gsoc-mark"
            src="/brand/gsoc-organizations-logo.svg"
            alt=""
            width="512"
            height="512"
          />
          <div class="directory-title">
            <span class="directory-site-title">GSoC Organizations</span>
          </div>
        </a>
      </div>
      <form class="global-search" role="search" action="/" method="get">
        <label class="sr-only" for="profile-organization-search"
          >Search organizations</label
        >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.75" cy="10.75" r="6.75"></circle>
          <path d="m15.75 15.75 4.25 4.25"></path>
        </svg>
        <input
          id="profile-organization-search"
          name="q"
          type="search"
          placeholder="Search organizations, technologies, topics…"
          autocomplete="off"
        />
      </form>
      <GitHubStarButton />
    </header>
    <ContributionAnnouncement embedded />
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Organizations</a><span>/</span><span aria-current="page"
        >{organization.name}</span
      >
    </nav>
    <section class="organization-hero">
      <div
        class:list={[
          'detail-logo',
          organization.logo ? 'is-loading' : 'is-fallback',
        ]}
        aria-hidden="true"
      >
        {
          organization.logo && (
            <img
              src={organization.logo}
              alt=""
              width="124"
              height="124"
              decoding="async"
              onload="this.parentElement.classList.remove('is-loading'); this.parentElement.classList.add('is-loaded')"
              onerror="this.hidden=true; this.parentElement.classList.remove('is-loading'); this.parentElement.classList.add('is-fallback')"
            />
          )
        }
        <span>{initials}</span>
      </div>
      <div class="organization-heading">
        <a
          class="category-label"
          href={`/category/${hubSlug(organization.category)}/`}
          >{organization.category}</a
        >
        <h1>{organization.name}</h1>
        <p>{organization.description}</p>
        <div class="hero-taxonomy">
          <div class="taxonomy-group">
            <span class="taxonomy-label">Technologies</span>
            <div class="tag-row">
              {
                organization.technologies.map((technology) => {
                  const slug = hubSlug(technology);
                  return technologyHubSlugs.has(slug) ? (
                    <a class="tag" href={`/technology/${slug}/`}>
                      {technology}
                    </a>
                  ) : (
                    <span class="tag">{technology}</span>
                  );
                })
              }
            </div>
          </div>
          <div class="taxonomy-group">
            <span class="taxonomy-label">Topics</span>
            <div class="tag-row">
              {
                organization.topics.map((topic) => {
                  const slug = hubSlug(topic);
                  return topicHubSlugs.has(slug) ? (
                    <a class="tag muted" href={`/topic/${slug}/`}>
                      {topic}
                    </a>
                  ) : (
                    <span class="tag muted">{topic}</span>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>
      <div class="hero-summary">
        <dl class="hero-metrics">
          <div>
            <dt>Total projects</dt><dd>{organization.totalProjects}</dd>
          </div>
          <div>
            <dt>Years participating</dt><dd>
              {organization.participationCount}
            </dd>
          </div>
          <div><dt>Most recent</dt><dd>{organization.latestYear}</dd></div>
        </dl>
        <div class="hero-actions">
          {
            organization.website && (
              <a
                class="button secondary-button"
                href={organization.website}
                target="_blank"
                rel="noreferrer"
              >
                Official website
              </a>
            )
          }
          {
            primaryRepository ? (
              <a
                class="button primary-button"
                href={primaryRepository.url}
                target="_blank"
                rel="noreferrer"
              >
                Repository
              </a>
            ) : repositoryFallback ? (
              <a
                class="button primary-button"
                href={repositoryFallback}
                target="_blank"
                rel="noreferrer"
              >
                Find repository
              </a>
            ) : null
          }
        </div>
      </div>
    </section>

    <div class="detail-layout">
      <div class="detail-main">
        <section
          class="detail-card participation-card"
          aria-labelledby="participation-heading"
        >
          <div class="section-heading">
            <div>
              <h2 id="participation-heading">
                Completed projects across years
              </h2>
            </div>
            <span>{organization.participationCount} program years</span>
          </div>
          <ParticipationChart participations={organization.participations} />
        </section>

        <section
          class="detail-card project-history-card"
          aria-labelledby="history-heading"
        >
          <div class="section-heading">
            <div>
              <h2 id="history-heading">Historical projects</h2>
            </div>
          </div>
          <div class="project-history" data-project-history>
            <div class="year-tabs-shell">
              <div
                class="year-tabs"
                role="tablist"
                aria-label="Participation years"
              >
                {
                  organization.participations.map(
                    (participation, participationIndex) => (
                      <button
                        class="year-tab"
                        type="button"
                        role="tab"
                        id={`year-tab-${organization.slug}-${participation.year}`}
                        aria-controls={`year-panel-${organization.slug}-${participation.year}`}
                        aria-selected={
                          participationIndex === 0 ? 'true' : 'false'
                        }
                        tabindex={participationIndex === 0 ? 0 : -1}
                        data-project-year-tab={participation.year}
                      >
                        {participation.year}
                      </button>
                    ),
                  )
                }
              </div>
            </div>
            {
              organization.participations.map(
                (participation, participationIndex) => (
                  <section
                    class="project-year-panel"
                    role="tabpanel"
                    id={`year-panel-${organization.slug}-${participation.year}`}
                    aria-labelledby={`year-tab-${organization.slug}-${participation.year}`}
                    data-project-year-panel={participation.year}
                    hidden={participationIndex !== 0}
                  >
                    <div class="project-year-toolbar">
                      <p>
                        <strong>{participation.year}</strong>
                        <span>
                          {participation.projectCount}{' '}
                          {participation.projectCount === 1
                            ? 'project'
                            : 'projects'}
                        </span>
                      </p>
                      {participation.archiveUrl && (
                        <a
                          class="participation-archive-link"
                          href={participation.archiveUrl}
                          target="_blank"
                          rel="noreferrer"
                        >
                          Official GSoC page ↗
                        </a>
                      )}
                    </div>
                    {participation.projects.length ? (
                      <div class="project-card-grid">
                        {participation.projects.map((project) => (
                          <article class="project-card">
                            <h3>{project.title}</h3>
                            {project.contributor && (
                              <p class="project-contributor">
                                Contributor: {project.contributor}
                              </p>
                            )}
                            <p>
                              {project.shortDescription ||
                                project.description ||
                                'No project summary is available in the archive.'}
                            </p>
                            <div class="project-links">
                              {project.projectUrl && (
                                <a
                                  class="project-link-button"
                                  href={project.projectUrl}
                                  target="_blank"
                                  rel="noreferrer"
                                >
                                  GSoC project page
                                </a>
                              )}
                              {project.codeUrl && (
                                <a
                                  class="project-link-button"
                                  href={project.codeUrl}
                                  target="_blank"
                                  rel="noreferrer"
                                >
                                  Code submission
                                </a>
                              )}
                            </div>
                          </article>
                        ))}
                      </div>
                    ) : (
                      <p class="empty-inline">
                        This organization participated in GSoC in{' '}
                        {participation.year}, but the official archive reports
                        no completed projects for that year.
                      </p>
                    )}
                  </section>
                ),
              )
            }
          </div>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-project-history]')
    .forEach((history) => {
      const tabs = [
        ...history.querySelectorAll<HTMLButtonElement>(
          '[data-project-year-tab]',
        ),
      ];
      const panels = [
        ...history.querySelectorAll<HTMLElement>('[data-project-year-panel]'),
      ];

      const activateTab = (tab: HTMLButtonElement, moveFocus = false) => {
        const selectedYear = tab.dataset.projectYearTab;

        tabs.forEach((candidate) => {
          const isSelected = candidate === tab;
          candidate.setAttribute('aria-selected', String(isSelected));
          candidate.tabIndex = isSelected ? 0 : -1;
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.projectYearPanel !== selectedYear;
        });

        if (moveFocus) tab.focus();
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activateTab(tab));
        tab.addEventListener('keydown', (event) => {
          let nextIndex: number | undefined;

          if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
          if (event.key === 'ArrowLeft')
            nextIndex = (index - 1 + tabs.length) % tabs.length;
          if (event.key === 'Home') nextIndex = 0;
          if (event.key === 'End') nextIndex = tabs.length - 1;
          if (nextIndex === undefined) return;

          event.preventDefault();
          activateTab(tabs[nextIndex], true);
        });
      });
    });
</script>
